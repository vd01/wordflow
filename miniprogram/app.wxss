page {
  background: #f5f6f8;
  color: #2c3e50;
  font-family: -apple-system, "Helvetica Neue", Helvetica, sans-serif;
}
.container { padding: 32rpx; }
.muted { color: #7f8c8d; font-size: 24rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx 0;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}
.btn {
  background: #2c3e50;
  color: #fff;
  border-radius: 12rpx;
  padding: 22rpx 0;
  text-align: center;
  margin: 16rpx 0;
  font-size: 30rpx;
}
.btn[disabled] { background: #95a5a6; }
