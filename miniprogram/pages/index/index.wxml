<view class="container">
  <!-- Offline banner -->
  <view class="offline-banner" wx:if="{{offline}}">
    📴 无网络连接 — 仅可复习本地单词
  </view>

  <view class="card">
    <view class="muted">服务器地址（https + 已备案域名）</view>
    <input class="input" value="{{serverAddr}}" bindinput="onAddr"
      placeholder="https://vocab-agent.duckdns.org:31588/" />

    <view class="muted" style="margin-top:20rpx">同步 Token</view>
    <input class="input" value="{{token}}" bindinput="onToken"
      placeholder="粘贴你的同步 token" password="{{true}}" />

    <view class="btn" bindtap="save">保存配置</view>
    <view class="btn" bindtap="testConn" disabled="{{busy || offline}}">测试连接</view>
    <view class="btn" bindtap="pullAll" disabled="{{busy || offline}}">拉取全部单词</view>
  </view>

  <view class="card">
    <view>本地单词：{{wordCount}}</view>
    <view style="margin-top:8rpx">待复习：{{dueCount}}</view>
    <view class="muted" style="margin-top:8rpx">上次同步：{{lastSyncDisplay || '从未'}}</view>
  </view>

  <view class="card">
    <view class="muted">每日新词上限（0 = 无限制）</view>
    <input class="input" type="number" value="{{dailyLimit}}" bindinput="onDailyLimit" placeholder="0 = 无限制" />
    <view class="muted" style="margin-top:8rpx">今日已学新词：{{dailyNewCount}}{{dailyLimit > 0 ? ' / ' + dailyLimit : ''}}</view>
  </view>

  <view class="muted" style="margin:16rpx 0">{{status}}</view>

  <view class="btn" bindtap="goWordList">单词本</view>
  <view class="btn btn-accent" bindtap="goReview">开始复习（{{dueCount}}）</view>
</view>
