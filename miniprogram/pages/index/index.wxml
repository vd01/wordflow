<view class="container">
  <!-- Offline banner -->
  <view class="offline-banner" wx:if="{{offline}}">
    📴 No network — local review only
  </view>

  <!-- Login section: shown when not logged in -->
  <view class="card" wx:if="{{!loggedIn}}">
    <view class="section-title">🔐 WeChat Login</view>
    <view class="muted">Scan the QR code on your desktop app, or enter the pairing code manually:</view>
    <input class="input" value="{{pairingCode}}" bindinput="onPairingCode"
      placeholder="Enter pairing code (e.g. A3F8K2M1)" maxlength="8" />
    <view class="btn btn-accent" bindtap="loginWithCode" disabled="{{loginBusy || offline || !pairingCode}}">
      {{loginBusy ? 'Logging in...' : 'Login with pairing code'}}
    </view>
  </view>

  <!-- Logged in section: shown when token is set -->
  <view class="card" wx:if="{{loggedIn}}">
    <view class="section-title">✅ Sync Connected</view>
    <view class="muted">Token: {{token.substring(0, 8)}}...</view>
    <view class="btn" bindtap="testConn" disabled="{{busy || offline}}">Test connection</view>
    <view class="btn" bindtap="pullAll" disabled="{{busy || offline}}">Pull all words</view>
  </view>

  <view class="card">
    <view>Local words: {{wordCount}}</view>
    <view style="margin-top:8rpx">Due for review: {{dueCount}}</view>
    <view class="muted" style="margin-top:8rpx">Last sync: {{lastSyncDisplay || 'never'}}</view>
  </view>

  <view class="card">
    <view class="limit-header">
      <text class="limit-label">Daily new word limit</text>
      <text class="limit-value" wx:if="{{dailyLimit > 0}}">{{dailyLimit}}</text>
      <text class="limit-value limit-unlimited" wx:else>∞</text>
    </view>
    <view class="limit-presets">
      <view class="preset-btn {{dailyLimit === 0 ? 'active' : ''}}" bindtap="setDailyLimit" data-value="0">∞ Off</view>
      <view class="preset-btn {{dailyLimit === 5 ? 'active' : ''}}" bindtap="setDailyLimit" data-value="5">5</view>
      <view class="preset-btn {{dailyLimit === 10 ? 'active' : ''}}" bindtap="setDailyLimit" data-value="10">10</view>
      <view class="preset-btn {{dailyLimit === 20 ? 'active' : ''}}" bindtap="setDailyLimit" data-value="20">20</view>
      <view class="preset-btn {{dailyLimit === 30 ? 'active' : ''}}" bindtap="setDailyLimit" data-value="30">30</view>
      <view class="preset-btn {{dailyLimit === 50 ? 'active' : ''}}" bindtap="setDailyLimit" data-value="50">50</view>
    </view>
    <view class="limit-stepper">
      <view class="stepper-btn" bindtap="decrementLimit">−</view>
      <text class="stepper-value">{{dailyLimit > 0 ? dailyLimit : '∞'}}</text>
      <view class="stepper-btn" bindtap="incrementLimit">+</view>
    </view>
    <view class="muted" style="margin-top:8rpx">Today's new words: {{dailyNewCount}}{{dailyLimit > 0 ? ' / ' + dailyLimit : ''}}</view>
  </view>

  <view class="muted" style="margin:16rpx 0">{{status}}</view>

  <view class="btn" bindtap="goWordList">Word list</view>
  <view class="btn btn-accent" bindtap="goReview">Start review ({{dueCount}})</view>
</view>
