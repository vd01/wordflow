<view class="container">
  <view class="card">
    <view class="muted">服务器地址（https + 已备案域名）</view>
    <input class="input" value="{{serverAddr}}" bindinput="onAddr"
      placeholder="https://sync.example.com" />

    <view class="muted" style="margin-top:20rpx">同步 Token</view>
    <input class="input" value="{{token}}" bindinput="onToken"
      placeholder="粘贴你的同步 token" password="{{true}}" />

    <view class="btn" bindtap="save">保存配置</view>
    <view class="btn" bindtap="testConn" disabled="{{busy}}">测试连接</view>
    <view class="btn" bindtap="pullAll" disabled="{{busy}}">拉取全部单词</view>
  </view>

  <view class="card">
    <view>本地单词：{{wordCount}}</view>
    <view class="muted" style="margin-top:8rpx">上次同步：{{lastSync}}</view>
  </view>

  <view class="muted" style="margin:16rpx 0">{{status}}</view>

  <view class="btn" bindtap="comingSoon">单词本</view>
  <view class="btn" bindtap="comingSoon">开始复习（FSRS）</view>
</view>
