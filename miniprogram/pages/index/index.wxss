.input {
  background: #fff;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 18rpx;
  margin-top: 8rpx;
}
.offline-banner {
  background: #e74c3c;
  color: #fff;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}
.btn-accent {
  background: #27ae60;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}
