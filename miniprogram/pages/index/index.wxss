.input {
  background: #fff;
  border: 1rpx solid #dcdfe6;
  border-radius: 8rpx;
  padding: 18rpx;
  margin-top: 8rpx;
}
.offline-banner {
  background: #e74c3c;
  color: #fff;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}
.btn-accent {
  background: #27ae60;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

/* ===== Daily Limit Controls ===== */
.limit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.limit-label {
  font-size: 28rpx;
  font-weight: 600;
}
.limit-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #27ae60;
  min-width: 60rpx;
  text-align: right;
}
.limit-unlimited {
  color: #95a5a6;
  font-size: 36rpx;
}
.limit-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.preset-btn {
  background: #f0f2f5;
  color: #2c3e50;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  text-align: center;
  border: 2rpx solid transparent;
}
.preset-btn.active {
  background: #e8f5e9;
  color: #27ae60;
  border-color: #27ae60;
  font-weight: 600;
}
.limit-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin: 8rpx 0;
}
.stepper-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #2c3e50;
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.stepper-value {
  font-size: 36rpx;
  font-weight: bold;
  min-width: 80rpx;
  text-align: center;
}
